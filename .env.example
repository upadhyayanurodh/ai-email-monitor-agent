# Configuration reference for the Email Monitor Agent
#
# These values are NOT stored in a local .env file — they are configured
# directly inside the Power Automate flow steps (URI fields, header values).
# This file documents which values you need and where they go.
# See docs/build-guide.md for the exact step each value belongs in.

# ── Step 3: HTTP action (Azure OpenAI) ───────────────────────────────────────
# URI field of the HTTP action
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/gpt-4.1-mini/chat/completions?api-version=2025-01-01-preview

# api-key header value of the HTTP action
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE

# ── Step 7: HTTP 1 action (Teams delivery) ────────────────────────────────────
# URI field of the HTTP 1 action in the True branch.
# This is the HTTP trigger URL from a second Power Automate flow
# that receives the card payload and posts it to the Teams channel.
# See docs/build-guide.md Step 0 for how to create that flow.
TEAMS_WEBHOOK_URL=https://YOUR-TENANT.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/YOUR-FLOW-ID/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=YOUR-SIG
